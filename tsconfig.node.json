{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"] },
    "baseUrl": "."
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*", "commands/**/*", "tests/**/*", "electron.vite.config.ts"]
}
